# Flags for the IFJ26 compiler source files
If:
    PathMatch: src/.*
CompileFlags:
    # -Wno-empty-translation-unit added due to a false positive warning
    Add: [-std=c17, -Wall, -Wextra, -pedantic, -Wno-empty-translation-unit]

---
# Flags for the IFJ26 compiler test files
If:
    PathMatch: tests/unit/.*
CompileFlags:
    Add:
        [
            -I../../tests/vendor,
            -I../../tests/vendor/snow_win,
            -I../../src,
            -DSNOW_ENABLED,
            -DSNOW_USE_FORK=0,
            -DSNOW_USE_FNMATCH=0,
            -std=gnu17,
            -Wall,
            -Wextra,
            -pedantic,
        ]

---
# Flags for unit test helper files
If:
    PathMatch: tests/unit/helpers/.*
CompileFlags:
    Add: [-I../../../tests/vendor, -I../../../tests/vendor/snow_win, -I../../../src]

---
# // AI generated by: Codex / gpt-6.2-sol
# // Prompt: "Configure clangd for the Linux-only memory test driver so it resolves project headers on Linux and avoids POSIX header errors on Windows."
# // Changes: Use the memory driver's C standard and source include path.
If:
    PathMatch: tests/memory_driver[.]c
CompileFlags:
    Add: [-I../src, -std=c17, -Wno-empty-translation-unit]

---
# Flags for .c files
If:
    PathMatch: .*\.c
CompileFlags:
    Add: [-xc]

---
# Flags for .h files
If:
    PathMatch: .*\.h
CompileFlags:
    Add: [-xc-header]
